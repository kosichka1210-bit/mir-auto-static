[Unit]
Description=MIR AUTO durable Telegram receiver
After=network-online.target mir-auto-telegram-worker.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/mir-auto/current
ExecStart=/usr/bin/php /srv/mir-auto/current/private/bin/poll-updates.php
Restart=always
RestartSec=2
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
