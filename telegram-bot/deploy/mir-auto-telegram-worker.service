[Unit]
Description=MIR AUTO Telegram update queue worker
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/mir-auto/current
ExecStart=/usr/bin/php /srv/mir-auto/current/private/bin/update-worker.php
Restart=always
RestartSec=2
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
